// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output = "../../../node_modules/@prisma/teams-client"
}

datasource db {
  provider = "postgresql"
}

enum TeamApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  LOCKED
}

enum TeamStatus {
  ACTIVE
  INACTIVE
  PENDING
  SUSPENDED
  LOCKED
}

enum TeamHistoryAction {
  CREATED
  RENAMED
  OWNER_CHANGED
  LOGO_CHANGED
  THEME_CHANGED
  SKIPPED_SEASON
  REJOINED
  WALLET_UPDATED
}

model Team {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  shortName     String
  code          String
  logoUrl       String?
  primaryColor  String?
  secondaryColor String?

  status        TeamStatus @default(PENDING)
  isActive      Boolean  @default(true)

  seasonTeams   SeasonTeam[]
  owners        TeamOwner[]
  histories     TeamHistory[]
  approvals     TeamApproval[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}

model TeamApproval {
  id               String   @id @default(uuid())
  tenantId         String
  teamId           String
  seasonTeamId     String?

  status           TeamApprovalStatus @default(DRAFT)
  comment          String?
  approvedBy       String?
  approvedAt       DateTime?

  team             Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  seasonTeam       SeasonTeam? @relation(fields: [seasonTeamId], references: [id], onDelete: Cascade)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
}

model SeasonTeam {
  id               String   @id @default(uuid())
  tenantId         String
  teamId           String
  seasonId         String
  leagueId         String

  displayName      String
  ownerId          String?
  logoUrl          String?
  primaryColor     String?
  secondaryColor   String?

  purseLimit       Decimal  @db.Decimal(12, 2)
  maxPlayers       Int
  minPlayers       Int
  playersBought    Int      @default(0)

  isActive         Boolean  @default(true)
  joinedAt         DateTime @default(now())

  team             Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  wallet           Wallet?
  stats            TeamStat?
  approvals        TeamApproval[]
  owners           TeamOwner[]
  histories        TeamHistory[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([teamId, seasonId, leagueId])
  @@index([tenantId, seasonId])
  @@index([leagueId])
}

model Wallet {
  id                String   @id @default(uuid())
  tenantId          String
  seasonTeamId      String   @unique

  totalBudget       Decimal  @db.Decimal(12, 2)
  spentBudget       Decimal  @default(0) @db.Decimal(12, 2)
  reservedBudget    Decimal  @default(0) @db.Decimal(12, 2)
  remainingBudget   Decimal  @db.Decimal(12, 2)

  seasonTeam        SeasonTeam @relation(fields: [seasonTeamId], references: [id], onDelete: Cascade)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
}

model TeamOwner {
  id             String   @id @default(uuid())
  tenantId       String
  teamId         String
  seasonTeamId   String?

  ownerId        String
  ownerName      String
  email          String?
  countryCode    String?
  phone          String?

  fromDate       DateTime @default(now())
  toDate         DateTime?

  team           Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  seasonTeam     SeasonTeam? @relation(fields: [seasonTeamId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())

  @@index([tenantId])
  @@index([teamId])
  @@index([seasonTeamId])
}

model TeamPresence {
  id            String   @id @default(uuid())
  tenantId      String
  seasonTeamId  String   @unique

  isOnline      Boolean  @default(false)
  socketId      String?
  lastSeenAt    DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([seasonTeamId])
}

model TeamHistory {
  id             String   @id @default(uuid())
  tenantId       String
  teamId         String
  seasonTeamId   String?

  action         TeamHistoryAction
  oldValue       Json?
  newValue       Json?
  changedBy      String?
  note           String?

  team           Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  seasonTeam     SeasonTeam? @relation(fields: [seasonTeamId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())

  @@index([tenantId])
  @@index([teamId])
  @@index([seasonTeamId])
}

model TeamStat {
  id                String   @id @default(uuid())
  tenantId          String
  seasonTeamId      String   @unique

  totalSpent        Decimal  @default(0) @db.Decimal(12, 2)
  purseLeft         Decimal  @default(0) @db.Decimal(12, 2)
  playersBought     Int      @default(0)
  topBid            Decimal? @db.Decimal(12, 2)
  averageBid        Decimal? @db.Decimal(12, 2)
  unsoldSlots       Int      @default(0)

  seasonTeam        SeasonTeam @relation(fields: [seasonTeamId], references: [id], onDelete: Cascade)

  updatedAt         DateTime @updatedAt

  @@index([tenantId])
}

