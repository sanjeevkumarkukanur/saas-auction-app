generator client {
  provider = "prisma-client-js"
  output = "../../../node_modules/@prisma/platform-client"
}

datasource db {
  provider = "postgresql"
}

model Page {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  sections    Section[]
  permissions Permission[]
}

model Section {
  id         String @id @default(uuid())
  pageId     String
  key        String
  title      String
  order      Int
  layoutJson Json
  stylesJson Json

  page   Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  fields Field[]

  @@index([pageId])
}

model Field {
  id        String @id @default(uuid())
  sectionId String
  key       String
  label     String
  type      String
  order     Int

  uiJson         Json
  stylesJson     Json
  validationJson Json

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
}

model Permission {
  id     String @id @default(uuid())
  key    String @unique
  name   String
  pageId String

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
}