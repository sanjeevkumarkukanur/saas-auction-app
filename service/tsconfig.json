{
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",

    "target": "ES2021",

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    "strictNullChecks": false,
    "noImplicitAny": false,

    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true,

    "baseUrl": ".",


    "paths": {
      "@libs/auth": [
        "libs/auth/src"
      ],
      "@libs/common": [
        "libs/common/src"
      ],
      "@libs/common/*": [
        "libs/common/src/*"
      ],
      "@libs/database": [
        "libs/database/src"
      ],
      "@libs/radius": [
        "libs/radius/src"
      ],
      "@libs/radius/*": [
        "libs/radius/src/*"
      ],
      "@libs/utils": [
        "libs/utils/src"
      ]
    }
  }
}